{
  "name": "@guchho/test",
  "version": "0.0.1",
  "description": "Lightweight JavaScript and TypeScript testing framework for the Guchho ecosystem.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchho/test.git"
  },
  "bugs": {
    "url": "https://github.com/guchho/test/issues"
  },
  "homepage": "https://github.com/guchho/test",
  "keywords": [
    "guchho",
    "test",
    "testing",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "guchho-test": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "remove-item dist --recursive --force",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "guchho lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:links": "node scripts/check-docs-links.mjs",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && c8 --reporter=lcov --reporter=text node --test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "guchho": "^1.0.9",
    "prettier": "^3.9.10",
    "remove-item": "^1.0.3"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "guchho": true
  }
}
